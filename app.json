//     "backgroundColor": "#ffffff",
//     "dark": {
//       "backgroundColor": "#000000"
//     }
//   }
// ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "@clerk/expo",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6597d777-d647-44ac-9276-8492d74164e7"
      }
    }
