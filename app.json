{
  "expo": {
    "name": "BookingApp",
    "slug": "BookingApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bookingap.png",
    "scheme": "bookingapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
     "adaptiveIcon": {
  "backgroundColor": "#FFFFFF",
  "foregroundImage": "./assets/images/bookingap.png"
},
      
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.BookingApp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
